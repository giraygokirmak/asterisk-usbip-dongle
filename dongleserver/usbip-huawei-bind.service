[Unit]
Description=Reconcile Huawei USB/IP exports
After=usbip-server.service
Requires=usbip-server.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usbip-huawei-bind.sh
TimeoutStartSec=30
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usbip-huawei-reconcile
